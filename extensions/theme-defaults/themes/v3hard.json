		"titleBar.activeForeground": "#8b888f",
		"titleBar.border": "#191919",
		"titleBar.inactiveBackground": "#191919",
		"titleBar.inactiveForeground": "#525053",

		// ── Text ──
		"textBlockQuote.background": "#191919",
		"textBlockQuote.border": "#363537",
		"textCodeBlock.background": "#191919",
		"textLink.activeForeground": "#f7f1ff",
		"textLink.foreground": "#fce566",
		"textPreformat.foreground": "#f7f1ff",
		"textSeparator.foreground": "#69676c",

		// ── Walkthrough / Welcome ──
		"walkThrough.embeddedEditorBackground": "#191919",
		"welcomePage.tileBackground": "#222222",
		"welcomePage.progress.background": "#363537",
		"welcomePage.progress.foreground": "#fce566",

		// ── Widget Shadow ──
		"widget.shadow": "#0a0a0a",

		// ── Chat (V3Code agents) ──
		"chat.requestBackground": "#191919",
		"chat.requestBorder": "#363537",
		"chat.slashCommandBackground": "#fce566",
		"chat.slashCommandForeground": "#222222",
		"chat.agentViewBackground": "#141414",
		"chat.editedFileForeground": "#fce566",
		"chat.avatarBackground": "#fce566",
		"chat.avatarForeground": "#222222",

		// ── Banner ──
		"banner.background": "#222222",
		"banner.foreground": "#f7f1ff",
		"banner.iconForeground": "#fce566"
	},

	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#69676C", "fontStyle": "italic" }
		},
		{
			"name": "Comment keywords (TODO, FIXME, etc.)",
			"scope": "comment keyword.codetag.notation",
			"settings": { "foreground": "#948AE3" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "meta.attribute-with-value string"],
			"settings": { "foreground": "#FCE566" }
		},
		{
			"name": "String template punctuation",
			"scope": ["punctuation.definition.string.template.begin", "punctuation.definition.string.template.end", "punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end"],
			"settings": { "foreground": "#FC618D" }
		},
		{
			"name": "Docstrings",
			"scope": ["string.quoted.docstring", "string.quoted.docstring punctuation.definition"],
			"settings": { "foreground": "#69676C" }
		},
		{
			"name": "Constants and numerics",
			"scope": ["constant", "constant.numeric", "constant.language", "constant.character.escape", "constant.other.placeholder", "support.constant"],
			"settings": { "foreground": "#948AE3" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "keyword.control", "keyword.operator", "keyword.other.template.begin", "keyword.other.template.end"],
			"settings": { "foreground": "#FC618D" }
		},
		{
			"name": "Storage types",
			"scope": ["storage.type", "storage.modifier"],
			"settings": { "foreground": "#5AD4E6", "fontStyle": "italic" }
		},
		{
			"name": "Storage keywords",
			"scope": ["storage", "storage.type.extends", "storage.type.function.arrow"],
			"settings": { "foreground": "#FC618D", "fontStyle": "normal" }
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "support.function", "meta.instance.constructor"],
			"settings": { "foreground": "#7BD88F" }
		},
		{
			"name": "Function calls",
			"scope": ["variable.function"],
			"settings": { "foreground": "#7BD88F" }
		},
		{
			"name": "Classes and types",
			"scope": ["entity.name.type", "entity.name.class", "support.type", "entity.other.inherited-class", "support.class"],
			"settings": { "foreground": "#5AD4E6" }
		},
		{
			"name": "Class declarations italic",
			"scope": ["entity.name.type.class.templated", "entity.name.type.class.generic", "entity.name.type.namespace"],
			"settings": { "foreground": "#5AD4E6" }
		},
		{
			"name": "Tags (HTML/JSX)",
			"scope": ["entity.name.tag", "entity.name.tag support.class.component"],
			"settings": { "foreground": "#FC618D" }
		},
		{
			"name": "Function operators",
			"scope": "entity.name.function.operator",
			"settings": { "foreground": "#FC618D" }
		},
		{
			"name": "Attributes",
			"scope": "entity.other.attribute-name",
			"settings": { "foreground": "#5AD4E6", "fontStyle": "italic" }
		},
		{
			"name": "CSS attribute names",
			"scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.css", "entity.other.animation-name.css"],
			"settings": { "foreground": "#7BD88F" }
		},
		{
			"name": "CSS pseudo-classes",
			"scope": ["entity.other.attribute-name.pseudo-class.css", "entity.other.pseudo-element.css"],
			"settings": { "foreground": "#5AD4E6", "fontStyle": "italic" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other", "variable.other.readwrite", "variable.other.member", "variable.other.property"],
			"settings": { "foreground": "#F7F1FF" }
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter", "parameters variable.function"],
			"settings": { "foreground": "#FD9353", "fontStyle": "italic" }
		},
		{
			"name": "Language variables (this, self, super)",
			"scope": ["variable.language", "variable.parameter.function.language.special"],
			"settings": { "foreground": "#BAB6C0", "fontStyle": "italic" }
		},
		{
			"name": "Enum members",
			"scope": "variable.other.enummember",
			"settings": { "foreground": "#948AE3" }
		},
		{
			"name": "CSS/SCSS variables",
			"scope": ["variable.scss", "variable.sass", "variable.other.less", "variable.declaration.less", "variable.css"],
			"settings": { "foreground": "#FD9353", "fontStyle": "italic" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "punctuation.definition.tag", "meta.brace.round", "meta.brace.square", "meta.brace.curly", "meta.delimiter.comma"],
			"settings": { "foreground": "#8B888F" }
		},
		{
			"name": "Nested source punctuation",
			"scope": ["punctuation.section.embedded", "punctuation.section.embedded entity.name.tag"],
			"settings": { "foreground": "#FD9353" }
		},
		{
			"name": "Markup headings",
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#FCE566" }
		},
		{
			"name": "Markup raw/inline",
			"scope": "markup.raw",
			"settings": { "foreground": "#FD9353" }
		},
		{
			"name": "Markup inserted",
			"scope": ["markup.inserted", "markup.inserted punctuation.definition.inserted"],
			"settings": { "foreground": "#7BD88F" }
		},
		{
			"name": "Markup deleted",
			"scope": ["markup.deleted", "markup.deleted punctuation.definition.deleted"],
			"settings": { "foreground": "#FC618D" }
		},
		{
			"name": "Markup changed",
			"scope": ["markup.changed", "markup.changed punctuation.definition.changed"],
			"settings": { "foreground": "#FCE566" }
		},
		{
			"name": "Links",
			"scope": "markup.underline.link",
			"settings": { "foreground": "#7BD88F" }
		},
		{
			"name": "JSON keys",
			"scope": "source.json meta.mapping.key string",
			"settings": { "foreground": "#F7F1FF" }
		},
		{
			"name": "Preprocessor",
			"scope": ["meta.preprocessor", "entity.name.constant.preprocessor"],
			"settings": { "foreground": "#948AE3" }
		},
		{
			"name": "Regex string punctuation",
			"scope": ["string.regexp punctuation.definition.string.begin", "string.regexp punctuation.definition.string.end"],
			"settings": { "foreground": "#FC618D" }
		},
		{
			"name": "Deprecated / invalid",
			"scope": ["invalid.deprecated", "invalid.illegal", "invalid.broken", "invalid.unimplemented"],
			"settings": { "foreground": "#FC618D", "fontStyle": "italic" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"class.declaration": { "foreground": "#5AD4E6" },
		"class.decorator": { "foreground": "#948AE3" },
		"enumMember": { "foreground": "#948AE3" },
		"namespace": { "foreground": "#5AD4E6" },
		"parameter": { "foreground": "#FD9353" },
		"property": { "foreground": "#F7F1FF" },
		"property.declaration": { "foreground": "#F7F1FF" },
		"variable": { "foreground": "#F7F1FF" },
		"variable.defaultLibrary": { "foreground": "#BAB6C0" }
	}
}
