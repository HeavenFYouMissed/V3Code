			"settings": { "foreground": "#a7c080" }
		},
		{
			"scope": ["keyword.control.import", "keyword.control.at-rule", "punctuation.definition.keyword", "variable.control.import.include", "keyword.other.import.java", "keyword.control.export"],
			"settings": { "foreground": "#e67e80" }
		},
		{
