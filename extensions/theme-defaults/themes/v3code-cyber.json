			"settings": { "foreground": "#e67e80" }
		},
		{
			"scope": ["keyword.operator", "keyword.operator.comparison", "keyword.operator.assignment", "keyword.operator.relational", "keyword.operator.logical", "keyword.operator.arithmetic"],
			"settings": { "foreground": "#e69875" }
		},
		{
			"scope": ["storage", "storage.type", "storage.type.function", "keyword.function", "storage.type.class", "storage.type.property", "keyword.other", "storage.type.enum", "storage.type.type", "storage.type.const.gdscript", "storage.type.var.gdscript"],
			"settings": { "foreground": "#e69875" }
		},
		{
			"scope": ["storage.type.interface", "keyword.control.export.tsx"],
			"settings": { "foreground": "#e67e80" }
		},
		{
			"scope": ["string", "string.template", "string.quoted.single", "punctuation.quasi.element", "string.other.link"],
