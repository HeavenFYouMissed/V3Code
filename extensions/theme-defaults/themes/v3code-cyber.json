			"scope": ["source.diff meta.diff.header.from-file", "source.diff markup.deleted.diff", "source.diff punctuation.definition.deleted.diff"],
			"settings": { "foreground": "#d699b6" }
		},
		{
			"scope": ["invalid.broken", "invalid.deprecated", "invalid.illegal", "invalid.unimplemented"],
			"settings": { "foreground": "#d699b6", "fontStyle": "italic" }
		},
		{
			"scope": ["entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
			"settings": { "foreground": "#dbbc7f" }
		},
		{
			"scope": ["keyword.other.unit"],
			"settings": { "foreground": "#d699b6" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"class.declaration": { "foreground": "#83c092" },
		"class.decorator": { "foreground": "#dbbc7f" },
		"enumMember": { "foreground": "#83c092" },
		"namespace": { "foreground": "#83c092" },
		"parameter": { "foreground": "#e1d7c3" },
		"property": { "foreground": "#e1d7c3" },
		"property.declaration": { "foreground": "#e1d7c3" },
		"variable": { "foreground": "#e1d7c3" },
		"variable.defaultLibrary": { "foreground": "#e69875" }
	}
}
