# Per-workspace active plan (update_plan persistence): runtime state, per-user, never commit.
.v3code/active-plan.json
# Per-workspace agent shell snapshot: generated by temporary run_command on Windows.
.v3code/shell-snapshot.bash
# Per-workspace runtime memory store (legacy address): per-user/per-machine data
# (memory.db + WAL) -- must NEVER be committed (multi-user product invariant). The
# global store lives outside the repo under userRoamingDataHome.
.context-bridge/
# Generated MCP tool-schema cache (grok.com / v3code / etc.) -- the editor's MCP client
# regenerates these from the live servers; not source, never commit.
mcps/
.firecrawl/
.tools/


