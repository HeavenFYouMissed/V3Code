# Shield this nested package from the repo-root .npmrc: the editor pins npm to
# Electron headers + build-from-source, which breaks wrangler's sharp prebuilds
# ("Please add node-gyp"). Values must be EMPTY (not "false") — install scripts
# like sharp's treat any non-empty npm_config_build_from_source as truthy.
disturl=
target=
runtime=
build_from_source=
legacy-peer-deps=true
